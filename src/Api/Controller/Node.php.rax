<?php
namespace Domain\{{php.namespace.host($options.backend.host)}}\Controller;

use Raxon\App;

use Raxon\Exception\ErrorException;
use Raxon\Module\Dir;
use Raxon\Module\File;
use Raxon\Module\Handler;
use Raxon\Module\Response;
use Raxon\Module\Controller;

use Domain\{{php.namespace.host($options.backend.host)}}\Service\FileSystem as Service;
use Domain\{{php.namespace.host($options.backend.host)}}\Service\Permission;

//use Domain\{{php.namespace.host($options.backend.host)}}\Service\Entity as Service;
//use Domain\{{php.namespace.host($options.backend.host)}}\Service\User as UserService;
//use Domain\{{php.namespace.host($options.backend.host)}}\Service\Permission as PermissionService;

use Exception;

use Raxon\Exception\ObjectException;
use Raxon\Exception\AuthorizationException;
use Raxon\Exception\FileWriteException;

class Node extends Controller {
    const DIR = __DIR__ . DIRECTORY_SEPARATOR;
    const NAME = 'Node';

    /**
     * @throws ErrorException
     * @throws FileWriteException
     * @throws ObjectException
     * @throws \Doctrine\ORM\Exception\ORMException
     * @throws \Doctrine\ORM\ORMException
     * @throws \Doctrine\DBAL\Exception
     * @throws Exception
     */
    public static function class_list(App $object): Response
    {
        //need permission

        $role = Permission::controller($object,Node::NAME, __FUNCTION__, $user);

        if($role->getName() === 'ROLE_ADMIN'){
            $dir_read = $object->config('project.dir.node') . 'Object' . $object->config('ds');
            $dir = new Dir();
            $list = $dir->read($dir_read);
            $result = [];
            if(is_array($list)){
                foreach($list as $nr => $file){
                    if($file->type === File::TYPE){
                        $extension = File::extension($file->url);
                        $basename = File::basename($file->name, $extension);
                        $explode = explode('.', $basename);
                        $module = $explode[0];
                        $submodule = null;
                        $command = null;
                        $subcommand = null;
                        $action = null;
                        $subaction = null;
                        if(array_key_exists(1, $explode)){
                            $submodule = $explode[1];
                        }
                        if(array_key_exists(2, $explode)){
                            $command = $explode[2];
                        }
                        if(array_key_exists(3, $explode)){
                            $subcommand = $explode[3];
                        }
                        if(array_key_exists(4, $explode)){
                            $action = $explode[4];
                        }
                        if(array_key_exists(5, $explode)){
                            $subaction = $explode[5];
                        }
                        if(!array_key_exists($basename, $result)){
                            $result[$basename] = [];
                        }
                        $result[$basename][] = [
                            'name' => $basename,
                            'module' => $module,
                            'submodule' => $submodule,
                            'command' => $command,
                            'subcommand' => $subcommand,
                            'action' => $action,
                            'subaction' => $subaction
                        ];
                    }
                }
            }
            ksort($result, SORT_NATURAL);
            $list = [];
            $list['nodeList'] = [];
            foreach($result as $name => $sub_list){
                foreach($sub_list as $nr => $record){
                    $list['nodeList'][] = $record;
                }
            }
            return new Response($list, Response::TYPE_JSON);
        }
        throw new Exception('Permission denied');
    }


    /**
     * @throws OptimisticLockException
     * @throws ObjectException
     * @throws ORMException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws Exception
     */
    public static function create(App $object): Response
    {
        $entity = $object->request('entity');
        if (Handler::method() === 'POST') {
            $data = Service::create($object, $entity);
            if(array_key_exists('node', $data)){
                return new Response(
                    $data,
                    Response::TYPE_JSON
                );
            } else {
                return new Response(
                    $data,
                    Response::TYPE_JSON,
                    Response::STATUS_UNPROCESSABLE_CONTENT
                );
            }
        }
        throw new Exception('Method must be a POST.');
    }

    /**
     * @throws ObjectException
     * @throws ORMException
     * @throws \Doctrine\ORM\ORMException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws Exception
     */
    public static function read(App $object): Response
    {
        $entity = $object->request('entity');
        $uuid = $object->request('uuid');
        $id = $object->request('id');
        if (Handler::method() === 'GET') {
            if($uuid){
                $data = Service::readByUuid($object, $entity, $uuid);
            } else {
                $data = Service::readById($object, $entity, $id);
            }
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        }
        throw new Exception('Method must be a GET.');
    }

    /**
     * @throws ObjectException
     * @throws ORMException
     * @throws \Doctrine\ORM\ORMException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws Exception
     */
    public static function update(App $object): Response
    {
        $entity = $object->request('entity');
        $id = $object->request('id');
        $uuid = $object->request('uuid');
        if(
            in_array(
                Handler::method(),
                [
                    'PATCH',
                    'PUT'
                ]
            )
        ){
            if($uuid){
                $data = Service::updateByUuid($object, $entity, $uuid);
            } else {
                $data = Service::updateById($object, $entity, $id);
            }
            if(array_key_exists('node', $data)){
                return new Response(
                    $data,
                    Response::TYPE_JSON
                );
            } else {
                return new Response(
                    $data,
                    Response::TYPE_JSON,
                    Response::STATUS_UNPROCESSABLE_CONTENT
                );
            }
        } else {
            throw new Exception('Wrong method used, use PATCH or PUT.');
        }
    }

    /**
     * @throws ObjectException
     * @throws ORMException
     * @throws AuthorizationException
     * @throws OptimisticLockException
     * @throws FileWriteException
     * @throws Exception
     */
    public static function delete(App $object){
        $entity = $object->request('entity');
        $entity1 = $object->request('entity1');
        $entity2 = $object->request('entity2');
        $id = $object->request('id');
        $uuid = $object->request('uuid');
        if($entity){
            if (Handler::method() === 'DELETE') {
                if($uuid){
                    $data = Service::deleteByUuid($object, $entity, $uuid);
                } else {
                    $data = Service::deleteById($object, $entity, $id);
                }
                return new Response(
                    $data,
                    Response::TYPE_JSON
                );
            } else {
                throw new Exception('Unknown method, use DELETE.');
            }
        }
        elseif($entity1 && $entity2) {
            if (Handler::method() === 'DELETE') {
                $data = Service::deleteRelation($object, $entity1, $entity2);
                if(array_key_exists('node', $data)){
                    return new Response(
                        $data,
                        Response::TYPE_JSON
                    );
                } else {
                    return new Response(
                        $data,
                        Response::TYPE_JSON,
                        Response::STATUS_UNPROCESSABLE_CONTENT
                    );
                }
            } else {
                throw new Exception('Unknown method, use DELETE.');
            }
        }
    }

    /**
     * @throws ObjectException
     * @throws QueryException
     * @throws NonUniqueResultException
     * @throws NoResultException
     * @throws Exception
     */
    public static function list(App $object): Response
    {
        ddd($object->request());

        $role = Permission::controller($object, $object->request('entity'), __FUNCTION__, $user);
        if(empty($role)) {
            throw new Exception('Role is empty...');
        }
        ddd($role->getName());
        $entity = $object->request('entity');
        $data = Service::list($object, $entity);
        return new Response(
            $data,
            Response::TYPE_JSON
        );
    }

    /**
     * @throws ORMException
     * @throws NonUniqueResultException
     * @throws ObjectException
     * @throws NoResultException
     * @throws Exception
     */
    public static function page(App $object): Response
    {
        $entity = $object->request('entity');
        $id = $object->request('id');
        $data = Service::page($object, $entity, $id);
        return new Response(
            $data,
            Response::TYPE_JSON
        );
    }

    /**
     * @throws ObjectException
     * @throws ORMException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws Exception
     */
    public static function get_relation(App $object){
        $entity1 = $object->request('entity1');
        $entity2 = $object->request('entity2');

        $set = Service::has_set($object, $entity1);
        $single_or_multiple = 'multiple';
        if(in_array(lcfirst($entity2), $set)){
            $single_or_multiple = 'single';
        }

        return Service::get_relation($object, $entity1, $entity2, $single_or_multiple);
    }

    /**
     * @throws Exception
     */
    private static function set(App $object): Response
    {
        $entity1 = $object->request('entity1');
        $entity2 = $object->request('entity2');
        if (Handler::method() === 'POST') {
            $data = Service::set($object, $entity1, $entity2);
            if(array_key_exists('node', $data)){
                return new Response(
                    $data,
                    Response::TYPE_JSON
                );
            } else {
                return new Response(
                    $data,
                    Response::TYPE_JSON,
                    Response::STATUS_UNPROCESSABLE_CONTENT
                );
            }
        } else {
            throw new Exception('Request method needs to be a POST.');
        }
    }
}